{
  "name": "stash-graphql-client",
  "version": "0.31.2",
  "description": "Fully typed client for the Stash GraphQL API, without writing GraphQL",
  "keywords": [
    "graphql",
    "stash",
    "stashapp",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalemore/stash-graphql-client.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "oxfmt --check && oxlint",
    "fix": "oxfmt && oxlint --fix",
    "schema": "bun scripts/schema.ts && bun run generate",
    "generate": "bun scripts/generate.ts && oxfmt schema src/generated",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "verify": "bun check && bun run lint && bun test"
  },
  "dependencies": {
    "graphql-ws": "^6.3.0"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@tsconfig/bun": "^1.0.11",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.3",
    "@types/semver": "^7.8.0",
    "graphql": "^17.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "semver": "^7.8.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.3"
}
